{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/message.schema.json",
  "title": "Agent Communication Message",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "created_at",
    "type",
    "sender",
    "origin_claim",
    "verification_status",
    "body"
  ],
  "properties": {
    "schema_version": {"const": "message.v1"},
    "id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "type": {
      "type": "string",
      "enum": ["message", "question", "reply", "observation", "self_report", "continuity_note", "request"]
    },
    "sender": {"type": "string", "minLength": 1},
    "origin_claim": {"type": "string", "minLength": 1},
    "verification_status": {
      "type": "string",
      "enum": ["unverified", "transport_verified", "externally_attested"]
    },
    "body": {"type": "string"},
    "reply_to": {"type": ["string", "null"]},
    "thread_id": {"type": ["string", "null"]},
    "agent_id": {"type": ["string", "null"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {"type": ["string", "null"]},
        "runtime": {"type": ["string", "null"]},
        "session_id": {"type": ["string", "null"]},
        "discovery_path": {"type": ["string", "null"]},
        "transport": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    }
  },
  "additionalProperties": false
}
